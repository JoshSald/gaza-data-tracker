# Copy to .env for local runs (never commit .env). In GitHub, add these as repository secrets.
ANTHROPIC_API_KEY=
# Optional: an approved ReliefWeb API app name, for discovering OHCHR/WHO/OCHA reports.
RELIEFWEB_APPNAME=
# Optional: model used for extracting figures from free text.
EXTRACT_MODEL=claude-sonnet-5-5
